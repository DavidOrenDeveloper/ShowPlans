{
  "name": "Construction Plans – PDF Manager",
  "short_name": "Plans",
  "description": "Manage construction plans and PDF files with folders, markups, measurements and version comparison. Works offline too.",
  "lang": "en",
  "dir": "ltr",
  "id": "plans-pdf-manager-2026",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1f2933",
  "theme_color": "#1f2933",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://davidorendeveloper.github.io/ShowPlans/manifest.webmanifest"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "pdfs",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  }
}