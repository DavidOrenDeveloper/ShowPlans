{
  "name": "תוכניות בנייה – ניהול ותצוגת PDF",
  "short_name": "תוכניות",
  "description": "ניהול תוכניות בנייה וקבצי PDF עם תיקיות, סימונים, מדידות והשוואת גרסאות. עובד גם ללא אינטרנט.",
  "lang": "he",
  "dir": "rtl",
  "id": "plans-pdf-manager-2026",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1f2933",
  "theme_color": "#1f2933",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "pdfs", "accept": ["application/pdf", ".pdf"] }] }
  }
}
